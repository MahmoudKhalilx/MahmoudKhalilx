# Base URL for the application under test
BASE_URL=https://www.saucedemo.com

# Environment (dev, staging, production)
ENV=staging

# Browser settings
HEADLESS=true
SLOW_MO=0

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# Retry settings
RETRIES=1

# Parallel workers
WORKERS=4
